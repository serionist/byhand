# LF in the repository and in every checkout, so a file is the same bytes on Windows, Linux and macOS.
* text=auto eol=lf

# Windows scripts keep CRLF, which cmd and older PowerShell need.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never touched: images, wheels, and the decks and sheets the tests read.
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.whl binary
*.pptx binary
*.xlsx binary
*.docx binary
*.pdf binary
