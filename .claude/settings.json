{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --cached --name-only)",
      "Bash(git diff HEAD)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git diff --stat origin/main...HEAD)",
      "Bash(git diff --name-only origin/main...HEAD)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git fetch origin)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(uv sync)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff format --check .)",
      "Bash(uv run basedpyright)",
      "Bash(uv run tools/gate.py quick)",
      "Bash(uv run tools/gate.py full)",
      "Bash(uv run tools/gate.py text --file -)"
    ]
  }
}
